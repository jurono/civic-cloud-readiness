{
  "name": "civic-cloud-readiness",
  "version": "0.1.0",
  "private": false,
  "type": "module",
  "description": "Vue 3 and TypeScript reference app for monitoring cloud platform readiness, incidents, and service reliability.",
  "scripts": {
    "api": "tsx watch server/index.ts",
    "dev": "concurrently -n api,web -c green,blue \"npm run api\" \"vite\"",
    "build": "vue-tsc --noEmit -p tsconfig.app.json && tsc --noEmit -p tsconfig.node.json && vite build",
    "preview": "vite preview",
    "test": "vitest run",
    "test:watch": "vitest",
    "lint": "eslint .",
    "format": "prettier --write ."
  },
  "dependencies": {
    "@vitejs/plugin-vue": "^5.2.4",
    "cors": "^2.8.6",
    "express": "^5.2.1",
    "pinia": "^2.3.1",
    "vue": "^3.5.13",
    "vue-router": "^4.5.0"
  },
  "devDependencies": {
    "@testing-library/jest-dom": "^6.6.3",
    "@testing-library/user-event": "^14.6.1",
    "@testing-library/vue": "^8.1.0",
    "@tsconfig/node22": "^22.0.0",
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.6",
    "@types/jsdom": "^28.0.3",
    "@types/node": "^22.15.3",
    "@vitejs/plugin-vue-jsx": "^4.1.2",
    "@vitest/coverage-v8": "^3.1.2",
    "@vue/eslint-config-prettier": "^10.2.0",
    "@vue/eslint-config-typescript": "^14.5.0",
    "@vue/test-utils": "^2.4.6",
    "@vue/tsconfig": "^0.9.1",
    "concurrently": "^9.2.3",
    "eslint": "^9.25.1",
    "eslint-plugin-vue": "^9.33.0",
    "jiti": "^2.7.0",
    "jsdom": "^25.0.1",
    "prettier": "^3.5.3",
    "tsx": "^4.22.4",
    "type-fest": "^4.41.0",
    "typescript": "~5.8.3",
    "vite": "^6.3.4",
    "vitest": "^3.1.2",
    "vue-tsc": "^2.2.8"
  },
  "engines": {
    "node": ">=20.19"
  }
}
